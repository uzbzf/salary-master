# Скопируйте в server/.env (Windows: copy .env.example .env).
# Подробная инструкция: server/TURSO.md
# server/.env в Git не отслеживается (см. server/.gitignore).

# ─── База данных ────────────────────────────────────────────────────────────
# Оставьте обе переменные пустыми, чтобы сервер использовал локальный файл
# server/salary_tracker.db (удобно для разработки).
#
# Чтобы работать с Turso:
#   1) установите CLI:   npm install -g @tursodatabase/cli
#   2) авторизуйтесь:   turso auth login
#   3) создайте базу:    turso db create salary-tracker
#   4) узнайте URL:      turso db show salary-tracker   -> libsql://<db>-<login>.turso.io
#   5) выпустите токен:  turso db tokens create salary-tracker
#
# ВАЖНО: TURSO_AUTH_TOKEN — секрет. Никогда не коммитьте его в Git.

#TURSO_DATABASE_URL=libsql://salary-tracker-yourlogin.turso.io
#TURSO_AUTH_TOKEN=eyJhbGciOi...

# ─── Сервер ─────────────────────────────────────────────────────────────────
PORT=3001

# Секрет для подписи JWT. В production обязательно задайте свой:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
#JWT_SECRET=

# Адрес фронтенда для CORS. Укажите домен деплоя клиента, если он отличается.
#CLIENT_URL=http://localhost:5173